{
    "Steam-WebKit": "./css/webkit.css",
    "Patches": [
        {
            "MatchRegexString": ".*http.*steam.*",
            "TargetJs": "./js/webkit.js"
        },
        {
            "MatchRegexString": "^Steam$",
            "TargetCss": "./css/steam.css",
            "TargetJs": "./js/steam.js"
        },
		{
            "MatchRegexString": "^Steam$",
            "TargetJs": "./js/neon.js"
        },
        {
            "MatchRegexString": ".friendsui-container",
            "TargetCss": "./css/friends.custom.css",
            "TargetJs": "./js/friends.custom.css.js"
        },
        {
            "MatchRegexString": "Menu$",
            "TargetCss": "./css/menus.css"
        },
        {
            "MatchRegexString": "Supernav$",
            "TargetCss": "./css/supernavs.css"
        },
		{
            "MatchRegexString": "DesktopUI",
            "TargetCss": "./css/library.css"
        }
    ],
    "UseDefaultPatches": true,
    "author": "NotKuromi",
    "description": "Theme with a liquid simulation based on GLSL",
    "name": "Neon in the woods",
    "version": "2.0",
    "github": {
        "owner": "NotKuromi",
        "repo_name": "NeonInTheWoods"
    },
    "tags": [
        "Animated",
        "Fancy",
        "Cute",
        "Cartoon",
		"Colorful",
		"Amphibia",
		"Light",
		"NightInTheWoods"
    ],
    "header_image": "https://github.com/NotKuromi/NeonInTheWoods/blob/main/Low.gif",
    "splash_image": "https://github.com/NotKuromi/NeonInTheWoods/blob/main/High.gif"
}
